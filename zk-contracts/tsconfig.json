{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  // The integration suite builds its Merkle trees with zk-api's own
  // implementation instead of a second copy. zk-api is an ES module package and
  // this one runs under CommonJS, so those files are compiled as CommonJS here.
  "ts-node": {
    "moduleTypes": {
      "../zk-api/src/**/*.ts": "cjs"
    }
  }
}
