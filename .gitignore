.DS_Store
*.log
# Except the raw records of every test run, which are the delivery evidence.
!docs/evidencias/*.log
.env
.env.*
!.env.example
node_modules/

# State of the end-to-end testnet run: test wallet keys, partner secrets, holder backups
zk-holder/e2e/state/

# Working state of the stress runs: local deployment, partner secrets, service output
zk-api/stress/out/
zk-contracts/stress/out/

# Build artifacts of the circuits: regenerated by `npm run build`
zk-circuits/build/

# Hardhat build output
zk-contracts/artifacts/
zk-contracts/cache/
zk-contracts/typechain-types/
