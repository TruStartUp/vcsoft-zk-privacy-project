{
  "name": "zk-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credential issuer, authorized disclosure service and verification API for the confidentiality layer",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:testnet": "DOTENV_CONFIG_PATH=.env.testnet tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:testnet": "DOTENV_CONFIG_PATH=.env.testnet node scripts/migrate-database.mjs",
    "prisma:reset": "prisma migrate reset --force",
    "issuer:rebuild": "tsx scripts/rebuild-issuer-state.ts",
    "partner:create": "tsx scripts/create-partner.ts",
    "partner:list": "tsx scripts/manage-partner.ts list",
    "partner:suspend": "tsx scripts/manage-partner.ts suspend",
    "partner:reactivate": "tsx scripts/manage-partner.ts reactivate",
    "partner:rotate-secret": "tsx scripts/manage-partner.ts rotate-secret",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "pretest": "node scripts/prepare-test-db.mjs",
    "stress:setup": "tsx stress/setup.ts",
    "stress:s1": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s1-verifications.ts",
    "stress:s2": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s2-reads.ts",
    "stress:s3": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s3-signatures.ts",
    "stress:s4": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s4-issuance.ts",
    "stress:s5": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s5-integrity.ts",
    "stress:s6": "tsx stress/s6-prover.ts",
    "stress:s8": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s8-capacity.ts",
    "stress:s9": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s9-rebuild.ts",
    "stress:s10": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s10-concurrent-writes.ts",
    "stress:s11": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s11-two-signers.ts",
    "stress:s12": "DOTENV_CONFIG_PATH=.env.stress tsx stress/s12-degraded-rpc.ts",
    "stress:s13": "DOTENV_CONFIG_PATH=.env.testnet tsx stress/s13-base-sepolia.ts",
    "stress:s13:reconcile": "DOTENV_CONFIG_PATH=.env.testnet tsx stress/s13-reconcile.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.1.0",
    "@scalar/express-api-reference": "^0.10.17",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "snarkjs": "^0.7.5",
    "viem": "^2.21.60"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^8.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}
